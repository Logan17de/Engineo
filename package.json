{
  "name": "engineo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @engineo/contracts build && pnpm --parallel --filter @engineo/web --filter @engineo/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @engineo/contracts build && pnpm -r --if-present typecheck",
    "test:ts": "pnpm --filter @engineo/contracts build && pnpm -r --if-present test",
    "test:security": "node --test scripts/*.test.mjs",
    "lint": "biome lint .",
    "format": "biome format --write . && cargo fmt --all",
    "format:check": "biome format . && cargo fmt --all -- --check",
    "check:ts": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:ts && pnpm run test:security && pnpm run build",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "check": "pnpm run check:ts && pnpm run check:rust",
    "audit:ts": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "typescript": "5.9.3"
  }
}
