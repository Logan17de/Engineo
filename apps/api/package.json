{
  "name": "@engineo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:configuration-maintenance": "node dist/db/configuration-maintenance-cli.js"
  },
  "dependencies": {
    "@engineo/contracts": "workspace:*",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
